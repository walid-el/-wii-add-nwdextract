<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Override at build time: /p:NavisDir="C:\Program Files\Autodesk\Navisworks Manage 2025" -->
    <NavisDir Condition="'$(NavisDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2025</NavisDir>
    <AssemblyName>NwdExtract</AssemblyName>
    <RootNamespace>NwdExtract</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
